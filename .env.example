# RestCloud iPaaS connection (never commit real values)
RC_BASE_URL=https://<host>/<context>
RC_PROFILE=uat
RC_USER=<service-account>
RC_PASS=<secret>
# Optional: use an existing token instead of user/password
# RC_TOKEN=<token>
# Optional: only allow these target hosts (comma separated, supports *.example.com)
# RC_ALLOWED_HOSTS=ipaas-test.example.com
# Optional: read RC_USER/RC_PASS (or token) from macOS Keychain / Linux secret-tool
# RC_KEYCHAIN=1
# RC_KEYCHAIN_SERVICE=rc-ipaas
# RC_KEYCHAIN_ACCOUNT=<service-account>
# RC_KEYCHAIN_TOKEN_ACCOUNT=token
# Optional: write access to a prod-profile target (default: read-only)
# RC_ALLOW_PROD_WRITE=1
# Optional: named targets (see rc.targets.example.json)
# RC_TARGET=orchestration
# RC_TARGETS={"targets":[{"name":"orchestration","baseUrl":"https://<host>/<context>","default":true}]}
# Optional: external LLM compatible endpoint for NL -> flow (falls back to offline rules)
# RC_LLM_URL=https://<llm-host>/v1/chat/completions
# RC_LLM_MODEL=<model>

# ── 数仓（Apache Doris）连接：dw CLI ──────────────────────────────
# 与环境无关的通用配置可写 ~/.dw/warehouse.json（0644）；
# 密码单独写 ~/.dw/warehouse-credentials.json（0600）。下面是最小环境变量写法。
# DW_HOST=<fe-host>
# DW_PORT=9030
# DW_HTTP_PORT=8030
# DW_USER=<user>
# DW_PASS=<secret>
# DW_DB=<database>
# DW_CATALOG=internal
# DW_TRANSPORT=http            # http = FE REST（零依赖）；cmd = 交给外部命令
# DW_CMD=doriscli sql {sql}    # DW_TRANSPORT=cmd 时的命令模板，{sql}/{env} 会被替换
# DW_ENV=<env-name>            # 多环境配置时指定用哪个
# DW_PROFILE=prod              # prod 且未设 DW_ALLOW_PROD_WRITE=1 → 只读闸门生效
# DW_ALLOW_PROD_WRITE=1
# DW_HOME=~/.dw
# DW_MASK_COLS=extra_col_a,extra_col_b
# 隧道（跳板机只认密码时，密码放 0600 文件，用 sshpass -f 读，不进 argv）
# DW_TUNNEL={"enabled":true,"jumpHost":"<jump-host>","jumpUser":"<user>","jumpPort":22,"passwordFile":"~/.ssh/jump_pass"}
